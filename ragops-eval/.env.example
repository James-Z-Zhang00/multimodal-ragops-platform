# Target search service
SEARCH_SERVICE_URL=http://localhost:8003
SEARCH_SERVICE_TIMEOUT=30

# Eval service
EVAL_SERVICE_HOST=0.0.0.0
EVAL_SERVICE_PORT=8010
EVAL_SERVICE_RELOAD=false
EVAL_SERVICE_LOG_LEVEL=info

# OpenAI — used by RAGAS for metric computation
# Use your real OpenAI key here, not the local gateway key
OPENAI_API_KEY=your-openai-api-key
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MLflow (optional — set log_to_mlflow=false in requests to skip)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ragops-retrieval-eval
